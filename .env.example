PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/drivefleet?retryWrites=true&w=majority
# Generate with: openssl rand -base64 32  (or node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
NODE_ENV=production

# Email (Nodemailer) - Optional, if not set emails are mocked to console
# Use Gmail App Password or any SMTP (SendGrid, Mailgun, Ethereal)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com

# Admin Access - Email whitelist (comma-separated for multiple admins) + Password gate (shared)
ADMIN_EMAIL=fahimrana3101@gmail.com,admin@drivefleet.com
ADMIN_PASS=Admin@123
